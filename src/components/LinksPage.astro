---
import { Image } from "astro:assets";
import hugu from "../assets/hugu-recorte.webp";
import thumb from "../assets/thumb-portfolio.webp";
import { LINKS } from "../config/links";
import { HTML_LANG, type Lang, linksText } from "../i18n/ui";
import Base from "../layouts/Base.astro";
import { alternates, hrefFor, withLinks } from "../lib/i18n";
import "../styles/motion.css";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = linksText[lang];

const social = withLinks([
  { name: "Instagram", short: "IG", href: hrefFor("instagram", LINKS.instagram) },
  { name: "Behance", short: "Bē", href: hrefFor("behance", LINKS.behance) },
  { name: "LinkedIn", short: "in", href: hrefFor("linkedin", LINKS.linkedin) },
  { name: "YouTube", short: "YT", href: hrefFor("youtube", LINKS.youtube) },
  { name: "GitHub", short: "GH", href: hrefFor("github", LINKS.github) },
  { name: "E-mail", short: "@", href: hrefFor("email", LINKS.email) },
]);

const cards = withLinks([
  {
    key: "portfolio",
    title: t.portfolio[0],
    sub: t.portfolio[1],
    btn: t.portfolio[2],
    href: LINKS.portfolio,
    mark: "",
  },
  {
    key: "behance",
    title: t.behance[0],
    sub: t.behance[1],
    btn: t.behance[2],
    href: LINKS.behance,
    mark: "Bē",
  },
]);

const media: { name: string; sign: string; icon: string; text: string; href: string }[] = [
  { name: "YouTube", sign: "youtube", icon: "▶", text: t.youtube, href: LINKS.youtube },
  { name: "Spotify", sign: "spotify", icon: "♪", text: t.spotify, href: LINKS.spotify },
];

// Chips decorativos de ferramentas (texto simples, sem logos de marca).
const tools = [
  { label: "Ps", cls: "t1" },
  { label: "Ai", cls: "t2" },
  { label: "Ae", cls: "t3" },
  { label: "Fig", cls: "t4" },
];

const langs = alternates("links");
---

<Base title={t.title} description={t.description} lang={HTML_LANG[lang]} alternates={langs}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;800&family=Instrument+Serif:ital@0;1&family=Caveat:wght@600&display=swap"
    />
  </Fragment>

  <div class="page">
    <div class="stage" aria-hidden="true">
      <div class="grid"></div>
      <div class="glow"></div>

      <!-- Perfil do Instagram em overlay, atrás da foto -->
      <div class="ig enter" style="--i: 0">
        <div class="ig-top">
          <span class="ig-avatar">
            <Image src={hugu} alt="" width={96} height={96} loading="eager" decoding="async" />
          </span>
          <div class="ig-meta">
            <strong>hugugomes <span class="ig-check">✓</span></strong>
            <span>Hugu Gomes | Designer</span>
          </div>
        </div>
        <p class="ig-bio">Branding &amp; Visual Identity<br />↘ Links úteis &amp; orçamento</p>
        <p class="ig-link">🔗 hugudesign.com.br/links</p>
      </div>

      <!-- Painel de Auto layout, no espírito de uma interface de design -->
      <div class="panel enter" style="--i: 2">
        <span class="panel-title">Auto layout</span>
        <div class="panel-row">
          <span class="pill is-on">↓</span>
          <span class="pill">↩</span>
          <span class="pill">→</span>
        </div>
        <div class="panel-row panel-dims"><span>W 390</span><span>H Hug</span></div>
      </div>

      {
        tools.map((tool, i) => (
          <span class={`tool enter ${tool.cls}`} style={`--i: ${i + 1}`}>
            {tool.label}
          </span>
        ))
      }

      <div class="photo skeleton" data-skeleton>
        <Image
          src={hugu}
          alt=""
          widths={[480, 720, 1100]}
          sizes="(max-width: 560px) 120vw, 640px"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="fade"></div>
    </div>

    <main class="content">
      <nav class="langs" aria-label={t.langLabel}>
        {
          langs.map((l) => (
            <a
              href={l.href}
              hreflang={HTML_LANG[l.lang]}
              aria-current={l.lang === lang ? "page" : undefined}
            >
              {l.lang.toUpperCase()}
            </a>
          ))
        }
      </nav>

      <header class="hero enter" style="--i: 3">
        <p class="kicker">Links</p>
        <h1>Hugu Gomes</h1>
        <p class="tagline">{t.tagline}</p>
        {
          social.length > 0 && (
            <ul class="social" aria-label={t.socialLabel}>
              {social.map((s) => (
                <li>
                  <a href={s.href} aria-label={s.name} rel="me noopener" target="_blank">
                    {s.short}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </header>

      <a class="cta enter" style="--i: 4" href={LINKS.whatsapp} rel="noopener" target="_blank">
        {t.cta} <span aria-hidden="true">→</span>
      </a>

      {
        cards.map((k, i) => (
          <article class="card enter" style={`--i: ${i + 5}`}>
            <div class="thumb">
              {k.key === "portfolio" ? (
                <Image src={thumb} alt="" width={144} height={144} loading="lazy" decoding="async" />
              ) : (
                <span aria-hidden="true">{k.mark}</span>
              )}
            </div>
            <div class="card-text">
              <h2>{k.title}</h2>
              <p>{k.sub}</p>
            </div>
            <a class="card-btn" href={k.href} rel="noopener" target="_blank" aria-label={k.btn}>
              <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }

      <section class="free enter" style="--i: 7" aria-labelledby="free-title">
        <h2 id="free-title">
          {t.centralA} <em>{t.centralB}</em>
        </h2>
        <p class="free-sub">{t.centralSub}</p>

        {
          LINKS.planner ? (
            <a class="material" href={LINKS.planner} rel="noopener" target="_blank">
              <div class="material-cover" aria-hidden="true">
                <span class="frame-label">Planner · Notion</span>
                <span class="mark">365</span>
              </div>
              <div class="material-body">
                <strong>{t.planner[0]}</strong>
                <span class="material-text">{t.planner[1]}</span>
                <span class="material-cta">
                  {t.get} <span aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          ) : (
            <div class="material is-soon">
              <div class="material-cover" aria-hidden="true">
                <span class="frame-label">Planner · Notion</span>
                <span class="mark">365</span>
              </div>
              <div class="material-body">
                <strong>{t.planner[0]}</strong>
                <span class="material-text">{t.planner[1]}</span>
                <span class="material-cta">{t.soon}</span>
              </div>
            </div>
          )
        }
      </section>

      <ul class="media enter" style="--i: 8">
        {
          media.map((m) => {
            const inner = (
              <>
                <span class="sign" aria-hidden="true">
                  {m.sign}
                  <svg viewBox="0 0 120 12" preserveAspectRatio="none">
                    <path d="M2 9 C 30 2, 70 2, 118 6" />
                  </svg>
                </span>
                <span class="media-icon" aria-hidden="true">
                  {m.icon}
                </span>
                <strong>{m.name}</strong>
                <span class="media-text">{m.text}</span>
              </>
            );
            return (
              <li>
                {m.href ? (
                  <a class="media-card" href={m.href} rel="noopener" target="_blank">
                    {inner}
                  </a>
                ) : (
                  <div class="media-card is-soon">
                    {inner}
                    <span class="badge">{t.soon}</span>
                  </div>
                )}
              </li>
            );
          })
        }
      </ul>

      <footer class="foot">hugudesign.com.br · {t.footer}</footer>
    </main>
  </div>
</Base>

<script>
  // Tira o skeleton quando a foto termina de carregar (ou já estava em cache).
  for (const box of document.querySelectorAll<HTMLElement>("[data-skeleton]")) {
    const img = box.querySelector("img");
    const done = () => box.classList.add("is-loaded");
    if (!img || img.complete) done();
    else {
      img.addEventListener("load", done, { once: true });
      img.addEventListener("error", done, { once: true });
    }
  }
</script>

<style>
  /* Azul característico do Hugu (o mesmo do site atual). */
  .page {
    --navy: #000a17;
    --navy-2: #061629;
    --blue: #004a82;
    --blue-2: #0b63ad;
    --sky: #6fb8ff;
    --ink: #eef3f9;
    --muted: #a9b8c9;
    --line: rgb(111 184 255 / 0.16);
    position: relative;
    max-width: 560px;
    margin: 0 auto;
    overflow: hidden;
    min-height: 100dvh;
    color: var(--ink);
  }
  /* Sobrescreve os tokens globais (claro/escuro): a /links é sempre azul-marinho. */
  :global(html:root) {
    --bg: #000a17;
    --fg: #eef3f9;
  }
  :global(body) {
    background: #000a17;
    color: #eef3f9;
    font-family: "Archivo", system-ui, sans-serif;
  }

  /* ---------- Cena do topo (decorativa) ---------- */
  .stage {
    position: absolute;
    inset: 0 0 auto;
    height: 600px;
    overflow: hidden;
  }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, #000 30%, transparent 85%);
  }
  .glow {
    position: absolute;
    left: 50%;
    top: 46%;
    width: 520px;
    height: 520px;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgb(11 99 173 / 0.55) 0%, rgb(0 74 130 / 0.2) 45%, transparent 70%);
  }

  .ig {
    position: absolute;
    left: 50%;
    top: 46px;
    width: 300px;
    margin-left: -170px;
    padding: 14px 16px;
    border-radius: 18px;
    background: rgb(6 22 41 / 0.78);
    border: 1px solid rgb(111 184 255 / 0.22);
    backdrop-filter: blur(6px);
    rotate: -3deg;
    font-size: 12px;
    line-height: 1.35;
  }
  .ig-top {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ig-avatar {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 999px;
    overflow: hidden;
    padding: 2px;
    background: linear-gradient(135deg, var(--sky), var(--blue));
  }
  .ig-avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: 999px;
    background: var(--navy-2);
  }
  .ig-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .ig-meta strong {
    font-size: 14px;
  }
  .ig-check {
    color: var(--sky);
  }
  .ig-bio {
    margin: 10px 0 4px;
    color: var(--ink);
  }
  .ig-link {
    margin: 0;
    color: var(--sky);
  }

  .panel {
    position: absolute;
    right: 8px;
    top: 250px;
    width: 128px;
    padding: 10px;
    border-radius: 12px;
    background: rgb(238 243 249 / 0.94);
    color: #0a1b2e;
    font-size: 11px;
    rotate: 4deg;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.35);
  }
  .panel-title {
    font-weight: 700;
  }
  .panel-row {
    display: flex;
    gap: 4px;
    margin-top: 8px;
  }
  .pill {
    flex: 1;
    display: grid;
    place-items: center;
    height: 22px;
    border-radius: 6px;
    background: #dde6f0;
  }
  .pill.is-on {
    background: var(--blue);
    color: #fff;
  }
  .panel-dims {
    justify-content: space-between;
    color: #3d4f63;
  }

  .tool {
    position: absolute;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    background: var(--navy-2);
    border: 1px solid rgb(111 184 255 / 0.35);
    color: var(--sky);
    font-weight: 800;
    font-size: 15px;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.4);
  }
  .t1 {
    left: 14px;
    top: 250px;
    rotate: -8deg;
  }
  .t2 {
    left: 40px;
    top: 330px;
    rotate: 6deg;
  }
  .t3 {
    right: 30px;
    top: 380px;
    rotate: -6deg;
  }
  .t4 {
    right: 120px;
    top: 200px;
    rotate: 10deg;
    font-size: 13px;
  }

  .photo {
    --skeleton-base: transparent;
    position: absolute;
    inset: 0;
  }
  .photo :global(img) {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: 410px;
    max-width: none;
    height: auto;
  }
  .fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgb(0 10 23 / 0.7) 80%, var(--navy) 100%);
  }

  /* ---------- Conteúdo ---------- */
  .content {
    position: relative;
    padding: 16px 18px 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .langs {
    align-self: flex-end;
    display: flex;
    padding: 3px;
    border-radius: 999px;
    background: rgb(0 10 23 / 0.7);
    backdrop-filter: blur(8px);
    border: 1px solid rgb(111 184 255 / 0.25);
  }
  .langs a {
    min-width: 44px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    font: 600 12px/1 "Archivo", sans-serif;
    letter-spacing: 0.08em;
    color: var(--ink);
    text-decoration: none;
  }
  .langs a[aria-current="page"] {
    background: var(--blue);
    color: #fff;
  }
  .hero {
    margin-top: 470px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .kicker {
    margin: 0;
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-size: 22px;
    color: var(--sky);
  }
  h1 {
    margin: 0;
    font-family: "Instrument Serif", serif;
    font-weight: 400;
    font-size: 56px;
    line-height: 0.95;
    color: #fff;
  }
  .tagline {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
  }
  .social {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .social a {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgb(111 184 255 / 0.1);
    border: 1px solid rgb(111 184 255 / 0.28);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .cta {
    min-height: 54px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 14px;
    background: var(--blue);
    border: 2px solid var(--sky);
    box-shadow: 5px 5px 0 var(--sky);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 16px;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .social a:active,
  .card-btn:active {
    transform: scale(0.97);
  }
  .cta:active {
    transform: translate(3px, 3px);
    box-shadow: 2px 2px 0 var(--sky);
  }

  .card {
    display: grid;
    grid-template-columns: 64px 1fr 44px;
    align-items: center;
    gap: 14px;
    padding: 12px;
    border-radius: 16px;
    background: var(--navy-2);
    border: 1px solid var(--line);
  }
  .thumb {
    width: 64px;
    height: 64px;
    border-radius: 10px;
    overflow: hidden;
    background: var(--blue);
    display: grid;
    place-items: center;
    font-family: "Instrument Serif", serif;
    font-size: 24px;
    color: #fff;
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card-text h2 {
    margin: 0;
    font-size: 16px;
  }
  .card-text p {
    margin: 3px 0 0;
    font-size: 13px;
    line-height: 1.35;
    color: var(--muted);
  }
  .card-btn {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--blue);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .free {
    margin-top: 22px;
    padding-top: 26px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .free h2 {
    margin: 0;
    font-family: "Instrument Serif", serif;
    font-weight: 400;
    font-size: 36px;
    line-height: 1;
  }
  .free h2 em {
    color: var(--sky);
  }
  .free-sub {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }
  .material {
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--navy-2);
    color: var(--ink);
    text-decoration: none;
  }
  .material-cover {
    position: relative;
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    background-color: var(--blue);
    background-image:
      linear-gradient(rgb(255 255 255 / 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.08) 1px, transparent 1px);
    background-size: 22px 22px;
  }
  .frame-label {
    position: absolute;
    left: 12px;
    top: 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #fff;
  }
  .mark {
    font-family: "Instrument Serif", serif;
    font-size: 72px;
    color: #fff;
    outline: 1px dashed rgb(255 255 255 / 0.6);
    outline-offset: 6px;
    padding: 0 10px;
    line-height: 1;
  }
  .material-body {
    padding: 14px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .material strong {
    font-family: "Instrument Serif", serif;
    font-weight: 400;
    font-style: italic;
    font-size: 22px;
    line-height: 1.15;
  }
  .material-text {
    font-size: 14px;
    line-height: 1.45;
    color: var(--muted);
  }
  .material-cta {
    margin-top: 4px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--sky);
    text-transform: uppercase;
  }

  .media {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  /* Botões no estilo "bloco com sombra dura" + assinatura manuscrita. */
  .media-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
    padding: 14px 12px 16px;
    border-radius: 16px;
    background: #dcecff;
    border: 2px solid var(--blue);
    box-shadow: 5px 5px 0 var(--sky);
    color: #04172b;
    text-decoration: none;
    min-height: 168px;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .media-card:active {
    transform: translate(3px, 3px);
    box-shadow: 2px 2px 0 var(--sky);
  }
  .sign {
    position: relative;
    font-family: "Caveat", cursive;
    font-size: 24px;
    line-height: 1;
    color: var(--blue);
    rotate: -6deg;
  }
  .sign svg {
    position: absolute;
    left: -4px;
    right: -4px;
    bottom: -6px;
    width: calc(100% + 8px);
    height: 8px;
    fill: none;
    stroke: var(--blue);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .media-icon {
    width: 64px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: #04172b;
    color: #fff;
    font-size: 18px;
  }
  .media-card strong {
    font-size: 15px;
  }
  .media-text {
    font-size: 12.5px;
    line-height: 1.35;
    color: #2a3d52;
  }
  .badge {
    font-size: 11px;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: var(--blue);
    text-transform: uppercase;
  }
  .foot {
    margin-top: 18px;
    text-align: center;
    font-size: 12px;
    color: var(--muted);
  }
  @media (hover: hover) {
    .social a:hover,
    .card-btn:hover,
    .cta:hover {
      background-color: var(--blue-2);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .social a,
    .cta,
    .media-card,
    .card-btn {
      transition: none;
    }
  }
</style>
