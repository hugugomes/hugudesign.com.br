---
import { Image } from "astro:assets";
import logo from "../assets/logo-hg.webp";
/**
 * Navegação fixa da home (issue #8): logo, âncoras, seletor de idioma,
 * botão de tema e CTA. Troca de idioma e tema são instantâneas (Emil).
 */
import { homeText } from "../i18n/home";
import type { Lang } from "../i18n/ui";
import { alternates } from "../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = homeText[lang];
const langs = alternates("");
const anchors = [
  { href: "#trabalhos", label: t.navWork },
  { href: "#servicos", label: t.navServices },
  { href: "#sobre", label: t.navAbout },
  { href: "#contato", label: t.navContact },
];
---

<header class="nav">
  <nav class="bar" aria-label={t.navLabel}>
    <a class="brand" href="#topo" aria-label="Hugu Gomes">
      <span class="chip">
        <Image src={logo} alt="" width={64} height={34} loading="eager" decoding="async" />
      </span>
      <span class="name">Hugu Gomes</span>
    </a>

    <ul class="anchors">
      {anchors.map((a) => (
        <li><a href={a.href}>{a.label}</a></li>
      ))}
    </ul>

    <div class="tools">
      <ul class="langs" aria-label={t.langLabel}>
        {langs.map((l) => (
          <li>
            <a
              href={l.href}
              hreflang={l.lang}
              aria-current={l.lang === lang ? "page" : undefined}
            >{l.lang.toUpperCase()}</a>
          </li>
        ))}
      </ul>
      <button type="button" class="theme" data-theme-toggle aria-label={t.themeLabel}>
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path></svg>
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
      </button>
      <a class="cta" href="#contato">{t.navCta}</a>
    </div>
  </nav>
</header>

<script>
  // Tema: alterna na hora (interação frequente, sem animação) e lembra a escolha.
  const root = document.documentElement;
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    const sync = () => btn.setAttribute("aria-pressed", String(root.dataset.theme === "dark"));
    sync();
    btn.addEventListener("click", () => {
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
      sync();
    });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--nav-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 14px var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 16px;
  }
  .chip {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--logo-bg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .chip :global(img) {
    width: 32px;
    height: auto;
  }
  .anchors {
    display: flex;
    gap: 28px;
    font-size: 15px;
    font-weight: 500;
  }
  .anchors a:hover {
    color: var(--accent);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .langs {
    display: flex;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .langs a {
    min-width: 44px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .langs a[aria-current="page"] {
    background: var(--fg);
    color: var(--bg);
  }
  .theme {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .sun {
    display: block;
  }
  :global(:root[data-theme="dark"]) .moon {
    display: none;
  }
  .cta {
    height: 44px;
    padding: 0 18px;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
    font-size: 14px;
  }
  .cta:hover {
    opacity: 0.88;
  }
  @media (max-width: 820px) {
    .anchors,
    .cta,
    .name {
      display: none;
    }
  }
</style>
