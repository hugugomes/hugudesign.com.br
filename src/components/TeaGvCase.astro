---
/**
 * Case do Simpósio TEA-GV (issue #37). Só é gerado com SHOW_TEAGV ligado
 * (src/config/flags.ts). As páginas com os valores das cotas nunca entram aqui.
 */
import { TEA_DS_CARDS, TEA_GROUPS, TEA_PRICE_PAGES } from "../config/tea-gv";
import { teaGvText } from "../i18n/tea-gv";
import Base from "../layouts/Base.astro";
import { buildPages, withoutPrices } from "../lib/gallery";
import Img from "./Img.astro";
import Lightbox from "./Lightbox.astro";
import PageGallery from "./PageGallery.astro";
import { teaImage } from "./teaGvImages";
import "../styles/motion.css";

const t = teaGvText;
const c = t.case;

function galleryOf(key: (typeof TEA_GROUPS)[number]["key"], limit?: number) {
  const group = TEA_GROUPS.find((g) => g.key === key);
  if (!group) return [];
  const names = t.pageNames[key];
  const pages = withoutPrices(buildPages(key, group.count, TEA_PRICE_PAGES[key]));
  return pages.slice(0, limit).map((page) => ({
    id: page.id,
    src: teaImage(page.id),
    caption: `${page.label} · ${names[page.num - 1] ?? ""}`,
  }));
}

const apresentacao = galleryOf("apresentacao");
const cotas = galleryOf("cotas");
const horizontal = galleryOf("apresentacao-h", 8);
const galleryLabels = {
  dialog: t.gallery.dialogLabel,
  close: t.gallery.close,
  prev: t.gallery.prev,
  next: t.gallery.next,
  of: t.gallery.of,
};
---

<Base title={c.title} description={c.description}>
  <div class="case">
    <nav class="bar wrap" aria-label={c.title}>
      <a href="/#trabalhos" class="back">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
        {c.back}
      </a>
    </nav>

    <main>
      <header class="wrap head">
        <p class="eyebrow enter" style="--i: 0">{c.eyebrow}</p>
        <h1 class="enter" style="--i: 1">{c.h1}</h1>
        <p class="lead enter" style="--i: 2">{c.lead}</p>
        <dl class="meta enter" style="--i: 3">
          {
            c.meta.map(([term, value]) => (
              <div>
                <dt>{term}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>
      </header>

      <div class="wrap hero">
        <Img
          src={teaImage("apresentacao-h-01")}
          alt={c.heroAlt}
          ratio="16 / 9"
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 1360px) 94vw, 1320px"
          eager
        />
      </div>

      <section class="wrap text rv">
        <h2>{c.challengeTitle}</h2>
        <p>{c.challengeText}</p>
      </section>

      <section class="wrap block">
        <h2 class="rv">{c.apresentacaoTitle}</h2>
        <PageGallery items={apresentacao} orient="portrait" title={c.apresentacaoTitle} openLabel={t.gallery.open} />
      </section>

      <section class="wrap block">
        <h2 class="rv">{c.cotasTitle}</h2>
        <p class="note rv">{c.cotasNote}</p>
        <PageGallery items={cotas} orient="portrait" title={c.cotasTitle} openLabel={t.gallery.open} />
      </section>

      <section class="wrap block">
        <h2 class="rv">{c.horizontalTitle}</h2>
        <PageGallery items={horizontal} orient="landscape" title={c.horizontalTitle} openLabel={t.gallery.open} />
      </section>

      <section class="wrap block">
        <h2 class="rv">{c.dsTitle}</h2>
        <p class="note rv">{c.dsText}</p>
        <ul class="ds">
          {
            TEA_DS_CARDS.map((card) => (
              <li class="rv">
                <Img
                  src={teaImage(`ds-${card}`)}
                  alt={t.preview.ds.cards[card]}
                  widths={[360, 540, 720]}
                  sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 320px"
                  class="ds-img"
                />
              </li>
            ))
          }
        </ul>
      </section>

      <a class="wrap next rv" href="/#trabalhos">
        {c.nextLabel}
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </main>
  </div>

  <Lightbox labels={galleryLabels} />
</Base>

<style>
  .case {
    --tea-sky: var(--accent);
    --tea-ink-soft: var(--muted);
    background: var(--bg);
    color: var(--fg);
    min-height: 100vh;
  }
  .wrap {
    width: min(100% - 32px, var(--wrap));
    margin-inline: auto;
  }
  .bar {
    padding-block: 20px;
  }
  .back,
  .next {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    font-weight: 500;
  }
  .back svg,
  .next svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .head {
    padding-block: 48px 40px;
  }
  .eyebrow {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  h1 {
    margin: 12px 0 0;
    font-size: clamp(2.6rem, 8vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .lead {
    margin: 20px 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.3rem, 2.6vw, 2rem);
    line-height: 1.3;
    color: var(--accent);
    max-width: 34ch;
  }
  .meta {
    margin: 40px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
  .meta dt {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .meta dd {
    margin: 6px 0 0;
  }
  .hero :global(.img) {
    border-radius: 12px;
  }
  .text {
    display: grid;
    gap: 16px;
    padding-block: 72px 24px;
  }
  @media (min-width: 900px) {
    .text {
      grid-template-columns: 1fr 1fr;
    }
  }
  .text h2,
  .block h2 {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    letter-spacing: -0.02em;
  }
  .text p {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .block {
    padding-block: 48px;
  }
  .block h2 {
    margin-bottom: 12px;
  }
  .note {
    margin: 0 0 28px;
    color: var(--muted);
  }
  .block h2 + :global(.pg) {
    margin-top: 28px;
  }
  .ds {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .ds :global(.ds-img) {
    border-radius: 20px;
  }
  .next {
    justify-content: flex-end;
    display: flex;
    padding-block: 48px 96px;
    margin-top: 24px;
    border-top: 1px solid var(--line);
    font-size: clamp(1.6rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .next svg {
    width: 1em;
    height: 1em;
  }
  .back:focus-visible,
  .next:focus-visible {
    outline: 3px solid var(--ring);
    outline-offset: 4px;
  }
</style>
