---
/**
 * Home nos três idiomas (issue #8). Hero, faixa e manifesto: #9.
 * Portfólio, serviços, sobre e contato entram nas issues #10–#11.
 */
import { homeText } from "../i18n/home";
import { HTML_LANG, type Lang } from "../i18n/ui";
import Base from "../layouts/Base.astro";
import { alternates } from "../lib/i18n";
import Hero from "./Hero.astro";
import Manifesto from "./Manifesto.astro";
import Marquee from "./Marquee.astro";
import SiteNav from "./SiteNav.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = homeText[lang];
---

<Base title={t.title} description={t.description} lang={HTML_LANG[lang]} alternates={alternates("")}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&family=Instrument+Serif:ital@0;1&display=swap"
    />
  </Fragment>

  <SiteNav lang={lang} />

  <main>
    <Hero lang={lang} />
    <Marquee lang={lang} />
    <Manifesto lang={lang} />
  </main>
</Base>
