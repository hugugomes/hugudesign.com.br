---
/**
 * Lightbox único da página: abre qualquer botão [data-full] dentro de uma
 * <PageGallery> e navega pelas páginas do mesmo material (setas, teclado e gesto).
 */
interface Props {
  labels: { dialog: string; close: string; prev: string; next: string; of: string };
}

const { labels } = Astro.props;
---

<dialog class="lb" aria-label={labels.dialog} data-of={labels.of}>
  <div class="lb-stage" data-lb-stage>
    <div class="lb-frame skeleton" data-lb-frame>
      <img alt="" data-lb-img decoding="async" />
    </div>
  </div>
  <div class="lb-bar">
    <p class="lb-cap" data-lb-cap aria-live="polite"></p>
    <div class="lb-actions">
      <span class="lb-count" data-lb-count></span>
      <button type="button" class="lb-btn" data-lb-prev aria-label={labels.prev}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
      </button>
      <button type="button" class="lb-btn" data-lb-next aria-label={labels.next}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
      </button>
      <button type="button" class="lb-btn lb-close" data-lb-close aria-label={labels.close}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
  </div>
</dialog>

<script>
  import { wrapIndex } from "../lib/gallery";

  const dialog = document.querySelector<HTMLDialogElement>("dialog.lb");
  const frame = dialog?.querySelector<HTMLElement>("[data-lb-frame]");
  const img = dialog?.querySelector<HTMLImageElement>("[data-lb-img]");
  const cap = dialog?.querySelector<HTMLElement>("[data-lb-cap]");
  const count = dialog?.querySelector<HTMLElement>("[data-lb-count]");

  if (dialog && frame && img && cap && count) {
    let items: HTMLButtonElement[] = [];
    let index = 0;
    let title = "";
    let opener: HTMLButtonElement | null = null;

    const markLoaded = () => frame.classList.add("is-loaded");
    img.addEventListener("load", markLoaded);
    img.addEventListener("error", markLoaded);

    const show = (next: number) => {
      index = wrapIndex(next, items.length);
      const item = items[index];
      if (!item?.dataset.full) return;
      frame.classList.remove("is-loaded");
      img.src = item.dataset.full;
      img.alt = `${title}, ${item.dataset.caption ?? ""}`;
      if (img.complete) markLoaded();
      cap.textContent = `${title} · ${item.dataset.caption ?? ""}`;
      count.textContent = `${index + 1} ${dialog.dataset.of ?? "/"} ${items.length}`;
      // Já pede a próxima página para a troca ser instantânea.
      const after = items[wrapIndex(index + 1, items.length)]?.dataset.full;
      if (after) new Image().src = after;
    };

    document.addEventListener("click", (event) => {
      const button = (event.target as Element | null)?.closest<HTMLButtonElement>(
        "[data-gallery] [data-full]",
      );
      if (!button) return;
      const gallery = button.closest<HTMLElement>("[data-gallery]");
      if (!gallery) return;
      items = [...gallery.querySelectorAll<HTMLButtonElement>("[data-full]")];
      title = gallery.dataset.title ?? "";
      dialog.dataset.orient = gallery.dataset.orient ?? "portrait";
      opener = button;
      show(items.indexOf(button));
      dialog.showModal();
    });

    dialog.querySelector("[data-lb-prev]")?.addEventListener("click", () => show(index - 1));
    dialog.querySelector("[data-lb-next]")?.addEventListener("click", () => show(index + 1));
    dialog.querySelector("[data-lb-close]")?.addEventListener("click", () => dialog.close());

    // Clique fora da página (no fundo escuro) fecha.
    dialog.addEventListener("click", (event) => {
      const target = event.target as Element;
      if (target === dialog || target.hasAttribute("data-lb-stage")) dialog.close();
    });

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") show(index - 1);
      if (event.key === "ArrowRight") show(index + 1);
    });

    // Gesto de arrastar para os lados no celular.
    let startX: number | null = null;
    dialog.addEventListener("pointerdown", (event) => {
      startX = event.clientX;
    });
    dialog.addEventListener("pointerup", (event) => {
      if (startX === null) return;
      const dx = event.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 48) show(index + (dx < 0 ? 1 : -1));
    });

    dialog.addEventListener("close", () => opener?.focus());
  }
</script>

<style>
  .lb {
    --lb-ink: #fff;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(4 22 32 / 0.94);
    color: var(--lb-ink);
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    /* Saída: mais curta e mais discreta que a entrada. */
    opacity: 0;
    transform: scale(0.99);
    transition:
      opacity var(--dur-exit) var(--ease-in),
      transform var(--dur-exit) var(--ease-in),
      overlay var(--dur-exit) allow-discrete,
      display var(--dur-exit) allow-discrete;
  }
  .lb:not([open]) {
    display: none;
  }
  .lb[open] {
    opacity: 1;
    transform: none;
    transition-duration: var(--dur-dialog);
    transition-timing-function: var(--ease-out);
  }
  @starting-style {
    .lb[open] {
      opacity: 0;
      transform: translateY(var(--enter-y)) scale(0.98);
    }
  }
  .lb::backdrop {
    background: transparent;
  }

  .lb-stage {
    min-height: 0;
    display: grid;
    place-items: center;
    padding: 20px 16px 8px;
    touch-action: pan-y;
  }
  .lb-frame {
    --skeleton-base: rgb(255 255 255 / 0.08);
    height: 100%;
    max-height: 100%;
    max-width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: 12px;
    overflow: hidden;
  }
  .lb[data-orient="landscape"] .lb-frame {
    height: auto;
    width: min(100%, 1400px, calc((100dvh - 120px) * 16 / 9));
    aspect-ratio: 16 / 9;
  }
  .lb-frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .lb-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px calc(14px + env(safe-area-inset-bottom));
    font-family: var(--tea-sans, inherit);
  }
  .lb-cap {
    margin: 0;
    font-size: 0.95rem;
    color: rgb(255 255 255 / 0.9);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .lb-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
  }
  .lb-count {
    font-variant-numeric: tabular-nums;
    font-size: 0.9rem;
    color: rgb(255 255 255 / 0.75);
    margin-right: 4px;
  }
  .lb-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.28);
    background: rgb(255 255 255 / 0.08);
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .lb-btn svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .lb-btn:focus-visible {
    outline: 3px solid #2bb8f2;
    outline-offset: 2px;
  }
  @media (hover: hover) {
    .lb-btn:hover {
      background: rgb(255 255 255 / 0.16);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lb,
    .lb[open] {
      transition: none;
      transform: none;
    }
  }
</style>
