---
import { canonicalUrl, pageTitle } from "../lib/seo";
import "../styles/global.css";

type HtmlLang = "pt-BR" | "en" | "es";

interface Props {
  /** Título da página; o layout acrescenta " — Hugu Gomes". */
  title?: string;
  description: string;
  lang?: HtmlLang;
  /** Mesma página nos outros idiomas (gera os links hreflang). */
  alternates?: { lang: "pt" | "en" | "es"; href: string }[];
}

const { title, description, lang = "pt-BR", alternates = [] } = Astro.props;
const site = Astro.site ?? "https://hugudesign.com.br";
const hreflang = { pt: "pt-BR", en: "en", es: "es" } as const;
const xDefault = alternates.find((a) => a.lang === "pt");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonicalUrl(Astro.url.pathname, site)} />
    {
      alternates.map((a) => (
        <link rel="alternate" hreflang={hreflang[a.lang]} href={canonicalUrl(a.href, site)} />
      ))
    }
    {xDefault && <link rel="alternate" hreflang="x-default" href={canonicalUrl(xDefault.href, site)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle(title)}</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
