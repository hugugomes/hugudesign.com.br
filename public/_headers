# Cabeçalhos do Cloudflare Pages (issue #5).
# Arquivos com hash no nome (gerados pelo Astro) nunca mudam: cache de 1 ano.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Segurança básica em todas as páginas.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Prévias para clientes ficam fora dos buscadores (issue #37).
/tea-gv
  X-Robots-Tag: noindex, nofollow
/tea-gv/*
  X-Robots-Tag: noindex, nofollow
